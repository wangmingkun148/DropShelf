<Window x:Class="DropShelf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DropShelf.Views.Controls"
        xmlns:l="clr-namespace:DropShelf.Localization"
        xmlns:models="clr-namespace:DropShelf.Models"
        Title="DropShelf" Style="{StaticResource AppWindowStyle}"
        Width="900" Height="640" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PageStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ThemeTileStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="6"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TipCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="16,16,16,18" />
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="/DropShelf;component/Assets/DropShelf-256.png" Width="16" Height="16"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="DropShelf" Margin="12,0,0,1" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 侧边导航 -->
        <Grid Grid.Row="1" Margin="6,0,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="NavList" Style="{StaticResource NavListStyle}" SelectedIndex="0" SelectionChanged="OnNavigationChanged">
                <ListBoxItem Tag="Overview">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Glyph.Home}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{l:Loc Overview}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Shelf">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Glyph.Mouse}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{l:Loc GesturesAndShelf}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Actions">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Glyph.Lightning}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{l:Loc QuickActionsTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Glyph.Color}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{l:Loc Appearance}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Glyph.Info}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="{l:Loc About}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <Button x:Name="ExitApplicationButton" Grid.Row="1" Style="{StaticResource SubtleButtonStyle}" Height="38"
                    HorizontalContentAlignment="Left" Padding="14,0" Command="{Binding ExitCommand}"
                    ToolTip="{l:Loc QuitTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Glyph.Power}" Style="{StaticResource GlyphTextStyle}" Margin="0,0,14,0" />
                    <TextBlock Text="{l:Loc QuitApp}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 页面内容 -->
        <Border x:Name="ContentLayer" Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid MaxWidth="860" Margin="36,26,36,36">
                    <!-- 概览 -->
                    <StackPanel x:Name="OverviewPage" Visibility="Visible">
                        <TextBlock Text="{l:Loc Overview}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="22,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/DropShelf;component/Assets/DropShelf-256.png" Width="56" Height="56"
                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,2,9,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource CautionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock x:Name="StatusTitleText" Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionTextStyle}" FontSize="13" Margin="18,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenShelfCommand}"
                                        VerticalAlignment="Center" Padding="16,6,16,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource Glyph.Add}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Loc OpenShelf}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="{l:Loc GettingStarted}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource TipCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Glyph.Mouse}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{l:Loc TipShakeTitle}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,12,0,4" />
                                    <TextBlock Text="{l:Loc TipShakeBody}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TipCardStyle}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Glyph.Library}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{l:Loc TipStackTitle}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,12,0,4" />
                                    <TextBlock Text="{l:Loc TipStackBody}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TipCardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{StaticResource Glyph.Lightning}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{l:Loc QuickActionsTitle}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,12,0,4" />
                                    <TextBlock Text="{l:Loc TipActionsBody}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{l:Loc General}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <controls:SettingsCard Icon="{StaticResource Glyph.Language}" Header="{l:Loc Language}" Description="{l:Loc LanguageDescription}">
                            <ListBox x:Name="LanguageSelector" Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding Language}">
                                <ListBoxItem Content="{l:Loc FollowSystem}" Tag="{x:Static models:AppLanguage.System}" />
                                <!-- 语言名称始终用该语言本身书写，切换错了也能认出来 -->
                                <ListBoxItem Content="中文" Tag="{x:Static models:AppLanguage.Chinese}" />
                                <ListBoxItem Content="English" Tag="{x:Static models:AppLanguage.English}" />
                            </ListBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Power}" Header="{l:Loc StartWithWindows}" Description="{Binding StartupDescription}">
                            <CheckBox x:Name="StartupEnabledBox" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Keyboard}" Header="{l:Loc GlobalHotkey}" Description="{Binding HotkeyDescription}">
                            <controls:HotkeyBox x:Name="HotkeyEditor" Gesture="{Binding Hotkey}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Help}" Header="{l:Loc Tutorial}" Description="{l:Loc TutorialDescription}">
                            <Button Content="{l:Loc ViewTutorial}" Command="{Binding ShowTutorialCommand}" MinWidth="96" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- 手势与置物架 -->
                    <StackPanel x:Name="ShelfPage" Style="{StaticResource PageStyle}">
                        <TextBlock Text="{l:Loc GesturesAndShelf}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20" />
                        <TextBlock Text="{l:Loc ShakeToOpen}" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,0,0,8" />
                        <controls:SettingsCard Icon="{StaticResource Glyph.Mouse}" Header="{l:Loc ShakeToOpenHeader}"
                                               Description="{l:Loc ShakeToOpenDescription}">
                            <CheckBox x:Name="GestureEnabledBox" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding GestureEnabled}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Lightning}" Header="{l:Loc Sensitivity}"
                                               Description="{l:Loc SensitivityDescription}"
                                               IsEnabled="{Binding GestureEnabled}">
                            <ListBox x:Name="SensitivitySelector" Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding Sensitivity}">
                                <ListBoxItem Content="{l:Loc SensitivityResponsive}" Tag="{x:Static models:GestureSensitivity.Responsive}" />
                                <ListBoxItem Content="{l:Loc SensitivityBalanced}" Tag="{x:Static models:GestureSensitivity.Balanced}" />
                                <ListBoxItem Content="{l:Loc SensitivitySteady}" Tag="{x:Static models:GestureSensitivity.Steady}" />
                            </ListBox>
                        </controls:SettingsCard>

                        <TextBlock Text="{l:Loc Shelf}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <controls:SettingsCard Icon="{StaticResource Glyph.ViewAll}" Header="{l:Loc Size}" Description="{l:Loc SizeDescription}">
                            <ListBox x:Name="ShelfSizeSelector" Style="{StaticResource SegmentedStyle}" SelectedValuePath="Tag"
                                     SelectedValue="{Binding ShelfSize}">
                                <ListBoxItem Content="{l:Loc SizeSmall}" Tag="{x:Static models:QuickShelfSize.Small}" />
                                <ListBoxItem Content="{l:Loc SizeMedium}" Tag="{x:Static models:QuickShelfSize.Medium}" />
                                <ListBoxItem Content="{l:Loc SizeLarge}" Tag="{x:Static models:QuickShelfSize.Large}" />
                            </ListBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.MoveToFolder}" Header="{l:Loc RemoveAfterDragOut}"
                                               Description="{l:Loc RemoveAfterDragOutDescription}">
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RemoveAfterDragOut}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Clear}" Header="{l:Loc CloseWhenEmpty}"
                                               Description="{l:Loc CloseWhenEmptyDescription}">
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CloseWhenEmpty}" />
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- 快速操作 -->
                    <StackPanel x:Name="ActionsPage" Style="{StaticResource PageStyle}">
                        <TextBlock Text="{l:Loc QuickActionsTitle}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="13" Margin="0,0,0,6"
                                   Text="{l:Loc ActionsPageDescription}" />
                        <TextBlock Text="{Binding ActionsSummary}" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,16,0,8" />
                        <ItemsControl x:Name="ActionOptionsList" ItemsSource="{Binding ActionOptions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:SettingsCard Icon="{Binding Glyph}" Header="{Binding Label}" Description="{Binding Description}">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding CanToggle}" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 外观 -->
                    <StackPanel x:Name="AppearancePage" Style="{StaticResource PageStyle}">
                        <TextBlock Text="{l:Loc Appearance}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20" />
                        <TextBlock Text="{l:Loc Theme}" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,0,0,10" />
                        <ListBox x:Name="ThemeSelector" SelectedValuePath="Tag" SelectedValue="{Binding Theme}" Background="Transparent"
                                 BorderThickness="0" ItemContainerStyle="{StaticResource ThemeTileStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Tag="{x:Static models:AppTheme.System}">
                                <StackPanel>
                                    <Grid Width="140" Height="92">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="7,0,0,7" Background="#F3F3F3" />
                                        <Border Grid.Column="1" CornerRadius="0,7,7,0" Background="#202020" />
                                        <Border Grid.ColumnSpan="2" Width="64" Height="64" CornerRadius="8" Background="#80808080">
                                            <Border Width="30" Height="30" CornerRadius="5" Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{l:Loc FollowSystem}" Margin="2,8,0,2" FontSize="13" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static models:AppTheme.Light}">
                                <StackPanel>
                                    <Border Width="140" Height="92" CornerRadius="7" Background="#F3F3F3" BorderBrush="#14000000" BorderThickness="1">
                                        <Border Width="64" Height="64" CornerRadius="8" Background="#FFFFFF" BorderBrush="#1A000000" BorderThickness="1">
                                            <Border Width="30" Height="30" CornerRadius="5" Background="#F3F3F3" BorderBrush="#26000000" BorderThickness="1" />
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{l:Loc ThemeLight}" Margin="2,8,0,2" FontSize="13" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Static models:AppTheme.Dark}">
                                <StackPanel>
                                    <Border Width="140" Height="92" CornerRadius="7" Background="#202020" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <Border Width="64" Height="64" CornerRadius="8" Background="#2B2B2B" BorderBrush="#26FFFFFF" BorderThickness="1">
                                            <Border Width="30" Height="30" CornerRadius="5" Background="#3B3B3B" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{l:Loc ThemeDark}" Margin="2,8,0,2" FontSize="13" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Text="{l:Loc Color}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <controls:SettingsCard Icon="{StaticResource Glyph.Brush}" Header="{l:Loc AccentColor}" Description="{Binding AccentDescription}">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Light}" Header="{l:Loc Materials}"
                                               Description="{l:Loc MaterialsDescription}" />
                    </StackPanel>

                    <!-- 关于 -->
                    <StackPanel x:Name="AboutPage" Style="{StaticResource PageStyle}">
                        <TextBlock Text="{l:Loc About}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="22,20">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/DropShelf;component/Assets/DropShelf-256.png" Width="48" Height="48"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DropShelf for Windows" Style="{StaticResource SubtitleTextStyle}" FontSize="18" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="13" Margin="0,3,0,0">
                                        <Run Text="{Binding Version, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{l:Loc AboutTagline}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{l:Loc DataLocations}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <controls:SettingsCard Icon="{StaticResource Glyph.Settings}" Header="{l:Loc SettingsFile}" Description="{Binding SettingsPath}">
                            <Button Content="{l:Loc OpenFolder}" Command="{Binding OpenSettingsFolderCommand}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Icon="{StaticResource Glyph.Document}" Header="{l:Loc Logs}"
                                               Description="{Binding LogDirectory}">
                            <Button Content="{l:Loc OpenFolder}" Command="{Binding OpenLogFolderCommand}" />
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
