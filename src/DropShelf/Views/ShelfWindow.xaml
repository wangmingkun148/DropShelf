<Window x:Class="DropShelf.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DropShelf.Views.Controls"
        xmlns:l="clr-namespace:DropShelf.Localization"
        Title="{Binding WindowTitle}"
        Style="{StaticResource AppWindowStyle}"
        Width="220" Height="260"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="{Binding IsPinned}"
        ShowActivated="False" WindowStartupLocation="Manual" AllowDrop="True" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 标题栏中的“移动/复制”切换：描边的小标签 -->
        <Style x:Key="ModeChipStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="7,0,8,1" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongBorderBrush}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部的快速操作：一格一张描边的小牌 -->
        <Style x:Key="ShelfActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource ShelfUnderCardBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 堆叠里的一张竖版小牌，缩略图印在牌面上；最上面一张的角标另外画在堆叠上面 -->
        <Style x:Key="StackCardStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="{x:Static controls:CardGridPanel.CardWidth}" />
            <Setter Property="Height" Value="{x:Static controls:CardGridPanel.CardHeight}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="Background" Value="{DynamicResource ShelfTileBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShelfTileBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 拖入时发到桌上的虚线牌 -->
        <Style x:Key="GhostCardStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="{x:Static controls:CardGridPanel.CardWidth}" />
            <Setter Property="Height" Value="{x:Static controls:CardGridPanel.CardHeight}" />
            <Setter Property="RadiusX" Value="5" />
            <Setter Property="RadiusY" Value="5" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="3 2" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Fill" Value="{DynamicResource AccentFaintBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <DataTemplate x:Key="CardContentTemplate">
            <Grid Margin="7,20,7,16">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- 牌右上角的移除：墨色小圆里一个叉，悬停时变红 -->
        <Style x:Key="TileRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" BorderThickness="1.5" Background="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource ShelfSolidBrush}">
                            <Path Data="M0,0 L6,6 M6,0 L0,6" Width="6" Height="6" Stroke="{DynamicResource ShelfSolidBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CriticalBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 平铺里的一张牌：竖版小牌印着缩略图，牌角印扩展名和花色，名字最多两行写在下面；悬停时抬起，选中时换成强调色描边 -->
        <Style x:Key="ShelfTileStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Tile" Background="Transparent" Loaded="OnRowLoaded" Unloaded="OnRowUnloaded">
                            <!-- 牌下只写得下名字，大小和类型放在悬停提示里 -->
                            <Grid.ToolTip>
                                <StackPanel MaxWidth="280">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid.ToolTip>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{x:Static controls:CardGridPanel.CardRowHeight}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 牌抬起时露出的桌面投影 -->
                            <Border x:Name="TileShadow" Width="{x:Static controls:CardGridPanel.CardWidth}" CornerRadius="5" Background="{DynamicResource ShelfUnderCardBorderBrush}" Opacity="0" />
                            <Grid x:Name="TileCard" Width="{x:Static controls:CardGridPanel.CardWidth}">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Border x:Name="TileFace" CornerRadius="5" BorderThickness="1.2" Background="{DynamicResource ShelfTileBrush}"
                                        BorderBrush="{DynamicResource ShelfTileBorderBrush}" />
                                <ContentPresenter ContentTemplate="{StaticResource CardContentTemplate}" />
                                <StackPanel Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding CardMark}" Style="{StaticResource CardRankTextStyle}" FontSize="10" LineHeight="10" />
                                    <Path Style="{StaticResource SuitStyle}" Tag="{Binding Suit}" Width="5" Height="5" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5"
                                            IsHitTestVisible="False">
                                    <StackPanel.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="{Binding CardMark}" Style="{StaticResource CardRankTextStyle}" FontSize="10" LineHeight="10" />
                                    <Path Style="{StaticResource SuitStyle}" Tag="{Binding Suit}" Width="5" Height="5" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="RemoveButton" Style="{StaticResource TileRemoveButtonStyle}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,-7,-7,0" ToolTip="{l:Loc RemoveItemTooltip}" Click="OnRemoveItemClick"
                                        Visibility="Hidden" />
                            </Grid>
                            <Border x:Name="TileName" Grid.Row="1" Margin="0,5,0,0" Padding="3,0" CornerRadius="4" HorizontalAlignment="Center"
                                    VerticalAlignment="Top" MaxWidth="70">
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TileShadow" Property="Opacity" Value="0.18" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="-4" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TileFace" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TileFace" Property="BorderThickness" Value="2" />
                                <Setter TargetName="TileName" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource ShelfSolidBrush}">
        <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.4">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" />
                    <TranslateTransform x:Name="SurfaceOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动移动窗口 -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButtonStyle}" Width="28" Height="30" FontSize="14"
                                  IsChecked="{Binding IsPinned}" ToolTip="{l:Loc PinTooltip}">
                        <ToggleButton.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{StaticResource Glyph.Pin}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Glyph.Pinned}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton.Content>
                    </ToggleButton>
                    <Button x:Name="TransferModeButton" Style="{StaticResource ModeChipStyle}" Click="OnTransferModeClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TransferModeGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock x:Name="TransferModeText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- 收起时堆叠下方已显示名称和数量，标题只在展开列表时显示；放在两组按钮之间，英文较长时截断而不是盖住按钮 -->
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                           Margin="4,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 在文件堆和列表之间切换，有项目时就显示 -->
                    <Button x:Name="ViewToggleButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="14"
                            Click="OnViewToggleClick" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="14"
                            Content="{StaticResource Glyph.More}" ToolTip="{l:Loc MoreTooltip}" Click="OnMoreClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="11"
                            Content="{StaticResource Glyph.Close}" ToolTip="{l:Loc CloseShelfTooltip}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <Grid x:Name="Body" Grid.Row="1" Margin="10,2,10,0">
                <!-- 空置物架 -->
                <Grid x:Name="EmptyView" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                        <!-- 桌上留着的一个空牌位 -->
                        <Grid Width="54" Height="72" HorizontalAlignment="Center">
                            <Rectangle RadiusX="5" RadiusY="5" StrokeThickness="1.5" StrokeDashArray="3 2" Stroke="{DynamicResource TextPrimaryBrush}" />
                            <Path Data="M7,0 V14 M0,7 H14" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{l:Loc DropHere}" Margin="0,10,0,0" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{l:Loc OrPaste}" Margin="0,3,0,0" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 堆叠：拖动即带走全部项目 -->
                <Grid x:Name="StackView" Background="Transparent" Cursor="Hand"
                      PreviewMouseLeftButtonDown="OnStackMouseDown" PreviewMouseMove="OnStackMouseMove"
                      PreviewMouseLeftButtonUp="OnStackMouseUp" MouseRightButtonUp="OnStackRightClick">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="StackCanvas" Width="160" Height="116">
                            <ContentControl x:Name="Card2" Style="{StaticResource StackCardStyle}" Canvas.Left="48" Canvas.Top="16"
                                            DataContext="{Binding Stack2}" ContentTemplate="{StaticResource CardContentTemplate}"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ShelfUnderCardBorderBrush}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-10" />
                                        <TranslateTransform X="-12" Y="2" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="Card1" Style="{StaticResource StackCardStyle}" Canvas.Left="48" Canvas.Top="14"
                                            DataContext="{Binding Stack1}" ContentTemplate="{StaticResource CardContentTemplate}"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ShelfUnderCardBorderBrush}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="7" />
                                        <TranslateTransform X="11" Y="1" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="Card0" Style="{StaticResource StackCardStyle}" Canvas.Left="48" Canvas.Top="12"
                                            DataContext="{Binding Stack0}" ContentTemplate="{StaticResource CardContentTemplate}" />
                            <!-- 最上面一张的角标：项目数和数量最多的文件类型，右下角倒过来再印一个 -->
                            <Grid x:Name="StackRankCorner" Canvas.Left="48" Canvas.Top="12" Width="{x:Static controls:CardGridPanel.CardWidth}" Height="{x:Static controls:CardGridPanel.CardHeight}" IsHitTestVisible="False" ClipToBounds="True">
                                <StackPanel Margin="5,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock x:Name="StackRank" Text="{Binding Count}" Style="{StaticResource CardRankTextStyle}" FontSize="15" LineHeight="15">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="StackRankShift" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <Path Style="{StaticResource SuitStyle}" Tag="{Binding StackSuit}" Width="6" Height="6" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,5,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource CardRankTextStyle}" FontSize="15" LineHeight="15" />
                                    <Path Style="{StaticResource SuitStyle}" Tag="{Binding StackSuit}" Width="6" Height="6" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Canvas>
                    </Viewbox>
                    <StackPanel x:Name="StackCaptionPanel" Grid.Row="1" Margin="2,2,2,4">
                        <TextBlock Text="{Binding StackCaption}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StackDetail}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 平铺：每个项目一张牌，只生成看得见的几行 -->
                <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent"
                         BorderThickness="0" Padding="0" Visibility="Collapsed" ItemContainerStyle="{StaticResource ShelfTileStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         PreviewMouseLeftButtonUp="OnListMouseUp" MouseDoubleClick="OnListDoubleClick"
                         PreviewMouseRightButtonDown="OnListRightButtonDown" Foreground="{DynamicResource TextPrimaryBrush}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CardGridPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <!-- 快速操作栏 -->
            <Grid x:Name="ActionBarHost" Grid.Row="2" Margin="8,6,8,8">
                <UniformGrid x:Name="ActionBar" Rows="1" Margin="0,2,0,0" />
            </Grid>

            <!-- 拖入时显示：放进置物架；拖到底部按钮区域时展开快速操作，可直接执行 -->
            <Grid x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ShelfDropZone" Margin="10,2,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 拖进来时原来那一摞最上面两张摊成小扇形，中间露出一个虚线空位；拖到快速操作上时整组变淡。静止角度和位移即摊开后的样子，没有那一项的牌由样式藏起 -->
                    <Viewbox x:Name="ShelfDropFrame" Stretch="Uniform" MaxHeight="104">
                        <Canvas Width="176" Height="108">
                            <ContentControl x:Name="FanRight" Style="{StaticResource StackCardStyle}" Canvas.Left="56" Canvas.Top="10"
                                            DataContext="{Binding Stack1}" ContentTemplate="{StaticResource CardContentTemplate}"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ShelfUnderCardBorderBrush}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="FanRightTurn" Angle="12" />
                                        <TranslateTransform x:Name="FanRightShift" X="34" Y="4" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="FanLeft" Style="{StaticResource StackCardStyle}" Canvas.Left="56" Canvas.Top="10"
                                            DataContext="{Binding Stack0}" ContentTemplate="{StaticResource CardContentTemplate}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="FanLeftTurn" Angle="-13" />
                                        <TranslateTransform x:Name="FanLeftShift" X="-34" Y="4" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <Rectangle x:Name="FanSlot" Style="{StaticResource GhostCardStyle}" Canvas.Left="56" Canvas.Top="10">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="FanSlotScale" />
                                        <TranslateTransform x:Name="FanSlotShift" Y="-3" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border x:Name="IncomingBadge" Canvas.Left="132" Canvas.Top="0" Height="20" Padding="7,0" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="IncomingText" FontFamily="{StaticResource NumberFont}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentBrush}" />
                            </Border>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="DropZoneText" Grid.Row="1" Text="{l:Loc ReleaseToAdd}" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Border x:Name="ActionTilesHost" Grid.Row="1" ClipToBounds="True">
                    <UniformGrid x:Name="ActionTiles" Rows="1" Margin="8,0,8,7" VerticalAlignment="Bottom" />
                </Border>
            </Grid>

            <!-- 正在处理 -->
            <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="{DynamicResource SmokeBrush}"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ProgressRing Width="30" Height="30" />
                    <TextBlock Text="{Binding BusyText}" Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 结果提示 -->
            <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" Margin="10,0,10,10" Padding="10,7,12,8"
                    CornerRadius="8" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastOffset" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToastGlyph" Text="{StaticResource Glyph.Completed}" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock x:Name="ToastText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
