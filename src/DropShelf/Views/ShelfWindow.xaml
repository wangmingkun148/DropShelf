<Window x:Class="DropShelf.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DropShelf.Views.Controls"
        xmlns:l="clr-namespace:DropShelf.Localization"
        Title="{Binding WindowTitle}"
        Style="{StaticResource AppWindowStyle}"
        Width="220" Height="260"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="{Binding IsPinned}"
        ShowActivated="False" WindowStartupLocation="Manual" AllowDrop="True" Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ShelfRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏中的“移动/复制”切换 -->
        <Style x:Key="ModeChipStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0,8,1" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlAltBrush}" />
        </Style>

        <!--
            阴影是单独的底层并缓存为位图（预制阴影）：卡片内容变化、窗口缩放或周围有动画时只合成这张图，不重新计算模糊。
            卡片底色不透明，正好盖住阴影层自身的底色。
        -->
        <Style x:Key="StackCardStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border>
                                <Border.CacheMode>
                                    <BitmapCache RenderAtScale="2" />
                                </Border.CacheMode>
                                <Border CornerRadius="10" Background="{DynamicResource ShelfTileBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.16" Color="Black" />
                                    </Border.Effect>
                                </Border>
                            </Border>
                            <Border CornerRadius="10" Background="{DynamicResource ShelfTileBrush}" BorderBrush="{DynamicResource ShelfTileBorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CardContentTemplate">
            <Grid Margin="9">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="34"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource ShelfSolidBrush}">
        <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.4">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SurfaceScale" />
                    <TranslateTransform x:Name="SurfaceOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动移动窗口 -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Margin="4,4,4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButtonStyle}" Width="28" Height="30" FontSize="14"
                                  IsChecked="{Binding IsPinned}" ToolTip="{l:Loc PinTooltip}">
                        <ToggleButton.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{StaticResource Glyph.Pin}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource Glyph.Pinned}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton.Content>
                    </ToggleButton>
                    <Button x:Name="TransferModeButton" Style="{StaticResource ModeChipStyle}" Click="OnTransferModeClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TransferModeGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock x:Name="TransferModeText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- 收起时堆叠下方已显示名称和数量，标题只在展开列表时显示 -->
                <TextBlock x:Name="TitleText" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                           MaxWidth="80" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 在文件堆和列表之间切换，只有一项时不需要列表 -->
                    <Button x:Name="ViewToggleButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="14"
                            Click="OnViewToggleClick" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="14"
                            Content="{StaticResource Glyph.More}" ToolTip="{l:Loc MoreTooltip}" Click="OnMoreClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Width="28" Height="30" FontSize="11"
                            Content="{StaticResource Glyph.Close}" ToolTip="{l:Loc CloseShelfTooltip}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <Grid x:Name="Body" Grid.Row="1" Margin="10,2,10,0">
                <!-- 空置物架 -->
                <Grid x:Name="EmptyView" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.2" StrokeDashArray="4 3"
                               Stroke="{DynamicResource ControlStrongBorderBrush}" Opacity="0.45" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                        <TextBlock Text="{StaticResource Glyph.Download}" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{l:Loc DropHere}" Margin="0,10,0,0" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{l:Loc OrPaste}" Margin="0,3,0,0" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 堆叠：拖动即带走全部项目 -->
                <Grid x:Name="StackView" Background="Transparent" Cursor="Hand"
                      PreviewMouseLeftButtonDown="OnStackMouseDown" PreviewMouseMove="OnStackMouseMove"
                      PreviewMouseLeftButtonUp="OnStackMouseUp" MouseRightButtonUp="OnStackRightClick">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="160" Height="116">
                            <ContentControl x:Name="Card2" Style="{StaticResource StackCardStyle}" Canvas.Left="38" Canvas.Top="20"
                                            DataContext="{Binding Stack2}" ContentTemplate="{StaticResource CardContentTemplate}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-10" />
                                        <TranslateTransform X="-12" Y="2" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="Card1" Style="{StaticResource StackCardStyle}" Canvas.Left="38" Canvas.Top="18"
                                            DataContext="{Binding Stack1}" ContentTemplate="{StaticResource CardContentTemplate}">
                                <ContentControl.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="7" />
                                        <TranslateTransform X="11" Y="1" />
                                    </TransformGroup>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl x:Name="Card0" Style="{StaticResource StackCardStyle}" Canvas.Left="38" Canvas.Top="16"
                                            DataContext="{Binding Stack0}" ContentTemplate="{StaticResource CardContentTemplate}" />
                            <Border x:Name="CountBadge" Canvas.Left="106" Canvas.Top="6" MinWidth="24" Height="24" CornerRadius="12"
                                    Padding="6,0" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource ShelfTileBrush}"
                                    BorderThickness="2" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentBrush}" />
                            </Border>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Row="1" Margin="2,2,2,4">
                        <TextBlock Text="{Binding StackCaption}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StackDetail}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 展开列表 -->
                <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent"
                         BorderThickness="0" Padding="0" Visibility="Collapsed" ItemContainerStyle="{StaticResource ShelfRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         PreviewMouseLeftButtonUp="OnListMouseUp" MouseDoubleClick="OnListDoubleClick"
                         PreviewMouseRightButtonDown="OnListRightButtonDown" Foreground="{DynamicResource TextPrimaryBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Background="Transparent" Loaded="OnRowLoaded" Unloaded="OnRowUnloaded">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" HorizontalAlignment="Left">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="RowGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                        FontSize="10" Content="{StaticResource Glyph.Close}" ToolTip="{l:Loc RemoveItemTooltip}"
                                        Click="OnRemoveItemClick" Visibility="Hidden" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                    <Setter TargetName="RowGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 快速操作栏 -->
            <Grid x:Name="ActionBarHost" Grid.Row="2" Margin="8,6,8,8">
                <Border Height="1" VerticalAlignment="Top" Margin="2,-4,2,0" Background="{DynamicResource DividerBrush}" />
                <UniformGrid x:Name="ActionBar" Rows="1" Margin="0,2,0,0" />
            </Grid>

            <!-- 拖入时显示：放进置物架；拖到底部按钮区域时展开快速操作，可直接执行 -->
            <Grid x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ShelfDropZone" Margin="10,2,10,6">
                    <Rectangle x:Name="ShelfDropFrame" RadiusX="10" RadiusY="10" StrokeThickness="1.6" StrokeDashArray="4 3"
                               Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentFaintBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource Glyph.Download}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock x:Name="DropZoneText" Text="{l:Loc ReleaseToAdd}" Margin="0,6,0,0" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="ActionTilesHost" Grid.Row="1" ClipToBounds="True">
                    <UniformGrid x:Name="ActionTiles" Rows="1" Margin="8,0,8,7" VerticalAlignment="Bottom" />
                </Border>
            </Grid>

            <!-- 正在处理 -->
            <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="{DynamicResource SmokeBrush}"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ProgressRing Width="30" Height="30" />
                    <TextBlock Text="{Binding BusyText}" Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 结果提示 -->
            <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" Margin="10,0,10,10" Padding="10,7,12,8"
                    CornerRadius="8" Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastOffset" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToastGlyph" Text="{StaticResource Glyph.Completed}" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock x:Name="ToastText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
