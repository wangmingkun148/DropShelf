<Window x:Class="DropShelf.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DropShelf.Localization"
        Title="{l:Loc OnboardingWelcomeTitle}" Style="{StaticResource AppWindowStyle}"
        Width="600" Height="560" ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MiniCard" TargetType="Border">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ShelfTileBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ShelfTileBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style x:Key="MiniShelf" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource ShelfSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Geometry x:Key="CursorGeometry">M0,0 L0,19 L4.6,14.4 L7.8,21.4 L11.2,19.9 L8.1,13 L14,13 Z</Geometry>

        <Storyboard x:Key="Step1Story" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="S1Float" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:1.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="Step2Story" RepeatBehavior="Forever" Duration="0:0:3.8">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Move" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="-48" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.76" Value="46" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.94" Value="-46" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.12" Value="44" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.32" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Shelf" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2ShelfScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2ShelfScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="Step3Story" RepeatBehavior="Forever" Duration="0:0:3.8">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3InMove" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="250" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3InMove" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-60" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3InCard" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3Stack" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3OutCard" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.75" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3OutMove" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="262">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3FolderScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.85" Value="1.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.1" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S3FolderScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.85" Value="1.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.1" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 拖到底部 → 按钮栏向上展开成一排操作并点亮“压缩” → 放下后收起，压缩包留在置物架上并提示 -->
        <Storyboard x:Key="Step4Story" RepeatBehavior="Forever" Duration="0:0:3.8">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Move" Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-150" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Move" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-110" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Card" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Tiles" Storyboard.TargetProperty="Height">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="30" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="66">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="66">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.54" Value="30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Buttons" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.35" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.54" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4TileRow" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.45" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Highlight" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4DropFrame" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.98" Value="0.45" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4DropZone" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.75" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Result" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.55" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S4Toast" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.2" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.45" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="262" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc OnboardingWelcomeTitle}" Margin="18,0,0,0" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="CaptionButtons" Style="{StaticResource CloseCaptionButtonStyle}" HorizontalAlignment="Right" Visibility="Collapsed"
                Click="OnCaptionCloseClick" ToolTip="{l:Loc CaptionClose}" AutomationProperties.Name="{l:Loc CaptionClose}" />

        <!-- 动画演示 -->
        <Border Grid.Row="1" Margin="24,0" CornerRadius="12" Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid ClipToBounds="True">
                <!-- 第 1 步：欢迎。和真实的置物架一样：左上角钉子和移动/复制切换，右上角菜单和关闭，堆叠下方是名称和数量 -->
                <Canvas x:Name="Step1Art" Width="552" Height="262">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="S1Float" />
                    </Canvas.RenderTransform>
                    <Border Canvas.Left="186" Canvas.Top="32" Width="180" Height="198" Style="{StaticResource MiniShelf}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{StaticResource Glyph.Pinned}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                                <Border Margin="8,0,0,0" Padding="6,1,6,2" CornerRadius="8" Background="{DynamicResource ControlAltBrush}">
                                    <TextBlock Text="{l:Loc TransferMove}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{StaticResource Glyph.List}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{StaticResource Glyph.More}" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{StaticResource Glyph.Close}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Border Style="{StaticResource MiniCard}" Margin="0,4,0,0">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="-10" />
                                            <TranslateTransform X="-12" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <TextBlock Text="{StaticResource Glyph.Picture}" Style="{StaticResource CardGlyph}" />
                                </Border>
                                <Border Style="{StaticResource MiniCard}" Margin="0,2,0,0">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="7" />
                                            <TranslateTransform X="11" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <TextBlock Text="{StaticResource Glyph.Text}" Style="{StaticResource CardGlyph}" />
                                </Border>
                                <Border Style="{StaticResource MiniCard}">
                                    <TextBlock Text="{StaticResource Glyph.Document}" Style="{StaticResource CardGlyph}" />
                                </Border>
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="62,-60,0,0"
                                        BorderBrush="{DynamicResource ShelfTileBrush}" BorderThickness="2">
                                    <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{l:Loc OnboardingSampleCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,2,0,6" />
                            <Border Grid.Row="3" Height="1" VerticalAlignment="Top" Margin="14,0" Background="{DynamicResource DividerBrush}" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{StaticResource Glyph.Zip}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="10,0" />
                                <TextBlock Text="{StaticResource Glyph.Copy}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="10,0" />
                                <TextBlock Text="{StaticResource Glyph.MoveToFolder}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="10,0" />
                                <TextBlock Text="{StaticResource Glyph.Info}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="10,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Canvas>

                <!-- 第 2 步：拖住并晃动 -->
                <Canvas x:Name="Step2Art" Width="552" Height="262" Visibility="Collapsed">
                    <Border x:Name="S2Shelf" Canvas.Left="186" Canvas.Top="30" Width="180" Height="196" Opacity="0"
                            Style="{StaticResource MiniShelf}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="S2ShelfScale" ScaleX="0.9" ScaleY="0.9" />
                        </Border.RenderTransform>
                        <Grid Margin="14">
                            <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.4" StrokeDashArray="4 3"
                                       Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentFaintBrush}" Margin="0,22,0,0" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                                <TextBlock Text="{StaticResource Glyph.Download}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                                <TextBlock Text="{l:Loc ReleaseToHold}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Canvas Canvas.Left="246" Canvas.Top="96">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="S2Move" />
                        </Canvas.RenderTransform>
                        <Border Style="{StaticResource MiniCard}" Width="60" Height="60">
                            <TextBlock Text="{StaticResource Glyph.Document}" Style="{StaticResource CardGlyph}" />
                        </Border>
                        <Path Canvas.Left="40" Canvas.Top="38" Data="{StaticResource CursorGeometry}" Fill="White" Stroke="Black"
                              StrokeThickness="1.2" StrokeLineJoin="Round" />
                    </Canvas>
                </Canvas>

                <!-- 第 3 步：放进来，再拖出去 -->
                <Canvas x:Name="Step3Art" Width="552" Height="262" Visibility="Collapsed">
                    <Border Canvas.Left="70" Canvas.Top="34" Width="170" Height="194" Style="{StaticResource MiniShelf}">
                        <Grid>
                            <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.2" StrokeDashArray="4 3" Margin="14,34,14,40"
                                       Stroke="{DynamicResource ControlStrongBorderBrush}" Opacity="0.4" />
                            <Border x:Name="S3Stack" Style="{StaticResource MiniCard}" Opacity="0" Margin="0,-6,0,0">
                                <TextBlock Text="{StaticResource Glyph.Picture}" Style="{StaticResource CardGlyph}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Canvas.Left="392" Canvas.Top="86" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="S3FolderScale" />
                        </StackPanel.RenderTransform>
                        <TextBlock Text="{StaticResource Glyph.Folder}" FontFamily="{StaticResource IconFont}" FontSize="64"
                                   Foreground="#E8A93B" HorizontalAlignment="Center" />
                        <TextBlock Text="{l:Loc OnboardingSampleFolder}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Canvas x:Name="S3InCard" Canvas.Left="126" Canvas.Top="96">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="S3InMove" X="250" Y="-60" />
                        </Canvas.RenderTransform>
                        <Border Style="{StaticResource MiniCard}">
                            <TextBlock Text="{StaticResource Glyph.Picture}" Style="{StaticResource CardGlyph}" />
                        </Border>
                        <Path Canvas.Left="38" Canvas.Top="36" Data="{StaticResource CursorGeometry}" Fill="White" Stroke="Black"
                              StrokeThickness="1.2" StrokeLineJoin="Round" />
                    </Canvas>
                    <Canvas x:Name="S3OutCard" Canvas.Left="126" Canvas.Top="96" Opacity="0">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="S3OutMove" />
                        </Canvas.RenderTransform>
                        <Border Style="{StaticResource MiniCard}">
                            <TextBlock Text="{StaticResource Glyph.Picture}" Style="{StaticResource CardGlyph}" />
                        </Border>
                        <Path Canvas.Left="38" Canvas.Top="36" Data="{StaticResource CursorGeometry}" Fill="White" Stroke="Black"
                              StrokeThickness="1.2" StrokeLineJoin="Round" />
                    </Canvas>
                </Canvas>

                <!-- 第 4 步：快速操作。和真实的置物架一样：拖到底部时按钮栏向上展开成一排操作，放下后压缩包留在置物架上 -->
                <Canvas x:Name="Step4Art" Width="552" Height="262" Visibility="Collapsed">
                    <Border Canvas.Left="156" Canvas.Top="24" Width="240" Height="214" Style="{StaticResource MiniShelf}">
                        <Grid>
                            <Grid Margin="10,14,10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="S4DropZone" Margin="0,0,0,6">
                                    <Rectangle x:Name="S4DropFrame" RadiusX="10" RadiusY="10" StrokeThickness="1.4" StrokeDashArray="4 3"
                                               Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentFaintBrush}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{StaticResource Glyph.Download}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="{l:Loc ReleaseToHold}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="S4Result" Opacity="0" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <Border Style="{StaticResource MiniCard}">
                                        <TextBlock Text="{StaticResource Glyph.Zip}" Style="{StaticResource CardGlyph}" />
                                    </Border>
                                    <TextBlock Text="{l:Loc OnboardingSampleArchive}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                                <Grid x:Name="S4Tiles" Grid.Row="1" Height="30" ClipToBounds="True">
                                    <Border Height="1" VerticalAlignment="Top" Margin="4,0" Background="{DynamicResource DividerBrush}" />
                                    <UniformGrid x:Name="S4Buttons" Rows="1" Height="30" VerticalAlignment="Bottom">
                                        <TextBlock Text="{StaticResource Glyph.Zip}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Glyph.Copy}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Glyph.MoveToFolder}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{StaticResource Glyph.Info}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </UniformGrid>
                                    <UniformGrid x:Name="S4TileRow" Rows="1" VerticalAlignment="Bottom" Opacity="0">
                                        <Grid Margin="2,0" Height="62">
                                            <Border CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                                            <Border x:Name="S4Highlight" CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{StaticResource Glyph.Zip}" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="{l:Loc ActionCompress}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="2,0" Height="62">
                                            <Border CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{StaticResource Glyph.Copy}" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="{l:Loc ActionCopyPath}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="2,0" Height="62">
                                            <Border CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{StaticResource Glyph.MoveToFolder}" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="{l:Loc ActionMoveTo}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="2,0" Height="62">
                                            <Border CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{StaticResource Glyph.Info}" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="{l:Loc ActionProperties}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
                            <Border x:Name="S4Toast" Opacity="0" VerticalAlignment="Bottom" Margin="10,0,10,10" Padding="8,6" CornerRadius="8"
                                    Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Glyph.Completed}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{DynamicResource SuccessBrush}" Margin="0,1,6,0" />
                                    <TextBlock Text="{l:Loc OnboardingSampleToast}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Canvas x:Name="S4Card" Canvas.Left="155" Canvas.Top="159">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="S4Move" X="-150" Y="-110" />
                        </Canvas.RenderTransform>
                        <Border Style="{StaticResource MiniCard}" Width="48" Height="48" Opacity="0.9">
                            <TextBlock Text="{StaticResource Glyph.Document}" Style="{StaticResource CardGlyph}" FontSize="22" />
                        </Border>
                        <Path Canvas.Left="38" Canvas.Top="36" Data="{StaticResource CursorGeometry}" Fill="White" Stroke="Black"
                              StrokeThickness="1.2" StrokeLineJoin="Round" />
                    </Canvas>
                </Canvas>
            </Grid>
        </Border>

        <!-- 说明文字 -->
        <StackPanel Grid.Row="2" Margin="34,26,34,0">
            <TextBlock x:Name="StepTitleText" Style="{StaticResource SubtitleTextStyle}" FontSize="22" />
            <TextBlock x:Name="StepBodyText" Margin="0,10,0,0" FontSize="14" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- 底部导航 -->
        <Grid Grid.Row="3" Margin="34,0,24,24">
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="{l:Loc Skip}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" MinWidth="72"
                        Click="OnSkipClick" />
                <Button x:Name="BackButton" Content="{l:Loc Back}" Margin="0,0,8,0" MinWidth="88" Click="OnBackClick" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" MinWidth="104"
                        Click="OnNextClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
