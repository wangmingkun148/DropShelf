<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 以下为浅色默认值，ThemeService 启动后会按当前主题与强调色整体替换。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E62B4EFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC2B4EFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F2B4EFF" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#102B4EFF" />
    <Color x:Key="AccentColor">#2B4EFF</Color>
    <SolidColorBrush x:Key="SystemAccentBrush" Color="#0078D4" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#15171C" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#575A63" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A7D85" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3A5AB" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8E5DE" />
    <SolidColorBrush x:Key="LayerBrush" Color="#00000000" />
    <SolidColorBrush x:Key="CardBrush" Color="#FBFAF6" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D2CEC5" />
    <SolidColorBrush x:Key="TableCardBorderBrush" Color="#C9C5BB" />
    <!-- 牌背、牌桌：运行时换成斜格纹和斜条纹，见 ThemeService -->
    <SolidColorBrush x:Key="CardBackFillBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="CardBackLineBrush" Color="#203BBF" />
    <SolidColorBrush x:Key="StackEdgeBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="SheetBorderBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="SheetBrush" Color="#FBFAF6" />
    <SolidColorBrush x:Key="TableFillBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="TableBrush" Color="#2B4EFF" />
    <SolidColorBrush x:Key="TableTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FBFAF6" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#F2EFE8" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#BDB8AE" />
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#5E6066" />
    <SolidColorBrush x:Key="ControlAltBrush" Color="#0D15171C" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0F15171C" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0A15171C" />
    <SolidColorBrush x:Key="SubtleSelectedBrush" Color="#1415171C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#DDD9D0" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FBFAF6" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#C9C5BB" />
    <SolidColorBrush x:Key="SettingRowBrush" Color="#F2EFE8" />
    <SolidColorBrush x:Key="SettingRowBorderBrush" Color="#E2DED5" />
    <SolidColorBrush x:Key="ShelfSolidBrush" Color="#E8E5DE" />
    <SolidColorBrush x:Key="ShelfBorderBrush" Color="#B4AFA4" />
    <SolidColorBrush x:Key="ShelfTileBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ShelfTileBorderBrush" Color="#15171C" />
    <SolidColorBrush x:Key="ShelfUnderCardBorderBrush" Color="#15171C" />
    <SolidColorBrush x:Key="ArtFrameBrush" Color="#DDD9D0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A8C93" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="CautionBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="SmokeBrush" Color="#CCE8E5DE" />

    <FontFamily x:Key="TextFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- 角标数字等窄体字：Windows 自带的 Bahnschrift，配合 FontStretch="Condensed" 使用 -->
    <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI</FontFamily>

    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">20</sys:Double>
    <sys:Double x:Key="TitleFontSize">28</sys:Double>

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <!-- 牌的圆角 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- 图标字形，Segoe Fluent Icons 与 Segoe MDL2 Assets 共有 -->
    <sys:String x:Key="Glyph.Close">&#xE711;</sys:String>
    <sys:String x:Key="Glyph.Pin">&#xE718;</sys:String>
    <sys:String x:Key="Glyph.Pinned">&#xE840;</sys:String>
    <sys:String x:Key="Glyph.More">&#xE712;</sys:String>
    <sys:String x:Key="Glyph.Info">&#xE946;</sys:String>
    <sys:String x:Key="Glyph.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Glyph.Zip">&#xF012;</sys:String>
    <sys:String x:Key="Glyph.FolderOpen">&#xE838;</sys:String>
    <sys:String x:Key="Glyph.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Glyph.Document">&#xE8A5;</sys:String>
    <sys:String x:Key="Glyph.Picture">&#xE8B9;</sys:String>
    <sys:String x:Key="Glyph.Link">&#xE71B;</sys:String>
    <sys:String x:Key="Glyph.Text">&#xE8D2;</sys:String>
    <sys:String x:Key="Glyph.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Glyph.Home">&#xE80F;</sys:String>
    <sys:String x:Key="Glyph.Color">&#xE790;</sys:String>
    <sys:String x:Key="Glyph.Lightning">&#xE945;</sys:String>
    <sys:String x:Key="Glyph.Keyboard">&#xE765;</sys:String>
    <sys:String x:Key="Glyph.Power">&#xE7E8;</sys:String>
    <sys:String x:Key="Glyph.Mouse">&#xE962;</sys:String>
    <sys:String x:Key="Glyph.Move">&#xE7C2;</sys:String>
    <sys:String x:Key="Glyph.ViewAll">&#xE8A9;</sys:String>
    <sys:String x:Key="Glyph.List">&#xE8FD;</sys:String>
    <sys:String x:Key="Glyph.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Glyph.Error">&#xE783;</sys:String>
    <sys:String x:Key="Glyph.Add">&#xE710;</sys:String>
    <sys:String x:Key="Glyph.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Glyph.Download">&#xE896;</sys:String>
    <sys:String x:Key="Glyph.MoveToFolder">&#xE8DE;</sys:String>
    <sys:String x:Key="Glyph.OpenWith">&#xE7AC;</sys:String>
    <sys:String x:Key="Glyph.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Glyph.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Glyph.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Glyph.Library">&#xE8F1;</sys:String>
    <sys:String x:Key="Glyph.Paste">&#xE77F;</sys:String>
    <sys:String x:Key="Glyph.SelectAll">&#xE8B3;</sys:String>
    <sys:String x:Key="Glyph.Clear">&#xE894;</sys:String>
    <sys:String x:Key="Glyph.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Glyph.Help">&#xE897;</sys:String>
    <sys:String x:Key="Glyph.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Glyph.Completed">&#xE930;</sys:String>
    <sys:String x:Key="Glyph.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Glyph.Collapse">&#xE73F;</sys:String>
    <sys:String x:Key="Glyph.Expand">&#xE740;</sys:String>
    <sys:String x:Key="Glyph.Brush">&#xE771;</sys:String>
    <sys:String x:Key="Glyph.Light">&#xE793;</sys:String>
    <sys:String x:Key="Glyph.NewWindow">&#xE78B;</sys:String>
    <sys:String x:Key="Glyph.Back">&#xE72B;</sys:String>
    <sys:String x:Key="Glyph.View">&#xE890;</sys:String>
    <sys:String x:Key="Glyph.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Glyph.Language">&#xE775;</sys:String>
    <sys:String x:Key="Glyph.History">&#xE81C;</sys:String>
    <sys:String x:Key="Glyph.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Glyph.Timer">&#xE823;</sys:String>
    <sys:String x:Key="Glyph.Swap">&#xE8AB;</sys:String>
</ResourceDictionary>
