# Arch Linux 打包脚本：从 GitHub 的版本标签取源码，用 CMake 编译并安装。
# 用法：makepkg -si（在包含本文件的目录里，和 linux/ 构建入口同级）。
pkgname=dropshelf
pkgver=3.0.8
pkgrel=1
pkgdesc="Temporarily hold files, text and links on a shelf (native Wayland)"
arch=('x86_64' 'aarch64')
url="https://github.com/pingod/DropShelf"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'gdk-pixbuf2' 'curl' 'glib2' 'libarchive' 'fontconfig')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname-$pkgver/linux" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}