// 程序图标和版本信息。图标与 C# 版共用一份。
#pragma code_page(65001)

#include <winver.h>
#include "version.h"

1 ICON "../../src/DropShelf/Assets/DropShelf.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DROPSHELF_VERSION_COMMA
PRODUCTVERSION DROPSHELF_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "DropShelf"
            VALUE "FileDescription", "通过鼠标手势呼出的 Windows 临时文件置物架"
            VALUE "FileVersion", DROPSHELF_FILE_VERSION_TEXT
            VALUE "InternalName", "DropShelf"
            VALUE "OriginalFilename", "DropShelf.exe"
            VALUE "ProductName", "DropShelf for Windows"
            VALUE "ProductVersion", DROPSHELF_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
